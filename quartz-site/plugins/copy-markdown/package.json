{
  "name": "@elimelt/quartz-copy-markdown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
  "quartz": {
    "name": "copy-markdown",
    "displayName": "Copy Markdown",
    "description": "Publishes source Markdown for each note and renders a copy control.",
    "category": [
      "emitter",
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 850,
    "defaultEnabled": true,
    "defaultOptions": {
      "outputDir": "static/markdown"
    },
    "components": {
      "CopyMarkdown": {
        "displayName": "Copy Markdown",
        "description": "Copies the current note's source Markdown.",
        "defaultPosition": "afterBody",
        "defaultPriority": 10
      }
    }
  }
}
